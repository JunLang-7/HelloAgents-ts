{
  "name": "@junlang-7/helloagents",
  "version": "0.0.0-development",
  "description": "Bun-first, Node.js-compatible TypeScript implementation of HelloAgents.",
  "keywords": [
    "agents",
    "ai",
    "bun",
    "llm",
    "typescript"
  ],
  "license": "CC-BY-NC-SA-4.0",
  "author": "JunLang-7",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JunLang-7/HelloAgents-ts.git"
  },
  "bugs": {
    "url": "https://github.com/JunLang-7/HelloAgents-ts/issues"
  },
  "homepage": "https://github.com/JunLang-7/HelloAgents-ts#readme",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "README_CN.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "build:js": "bun build ./hello_agents/index.ts --outdir ./dist --target node --format esm --sourcemap=external",
    "build:types": "tsc -p tsconfig.build.json",
    "build": "bun run build:js && bun run build:types",
    "test:node": "node ./tests/node-smoke.mjs && node ./tests/node-todo-devlog-smoke.mjs",
    "test:package": "node ./tests/package-consumer.mjs",
    "test:integration": "bun run build && node ./tests/real-api-opt-in.mjs",
    "prepublishOnly": "bun run typecheck && bun run lint && bun run test && bun run build && bun run test:node && bun run test:package"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.19.1",
    "eslint": "^9.39.1",
    "prettier": "^3.9.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  }
}
