{
  "name": "@junlang-7/helloagents",
  "version": "0.2.0",
  "description": "Teaching-oriented TypeScript port of the HelloAgents learn_version branch.",
  "keywords": [
    "agents",
    "ai",
    "bun",
    "llm",
    "typescript"
  ],
  "license": "CC-BY-NC-SA-4.0",
  "author": "JunLang-7",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JunLang-7/HelloAgents-ts.git"
  },
  "bugs": {
    "url": "https://github.com/JunLang-7/HelloAgents-ts/issues"
  },
  "homepage": "https://github.com/JunLang-7/HelloAgents-ts#readme",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./memory/rag": {
      "types": "./dist/memory/rag/index.d.ts",
      "import": "./dist/memory/rag/index.js",
      "default": "./dist/memory/rag/index.js"
    },
    "./memory/storage": {
      "types": "./dist/memory/storage/index.d.ts",
      "import": "./dist/memory/storage/index.js",
      "default": "./dist/memory/storage/index.js"
    },
    "./memory/types": {
      "types": "./dist/memory/types/index.d.ts",
      "import": "./dist/memory/types/index.js",
      "default": "./dist/memory/types/index.js"
    },
    "./protocols": {
      "types": "./dist/protocols/index.d.ts",
      "import": "./dist/protocols/index.js",
      "default": "./dist/protocols/index.js"
    },
    "./protocols/mcp": {
      "types": "./dist/protocols/mcp/index.d.ts",
      "import": "./dist/protocols/mcp/index.js",
      "default": "./dist/protocols/mcp/index.js"
    },
    "./protocols/a2a": {
      "types": "./dist/protocols/a2a/index.d.ts",
      "import": "./dist/protocols/a2a/index.js",
      "default": "./dist/protocols/a2a/index.js"
    },
    "./protocols/anp": {
      "types": "./dist/protocols/anp/index.d.ts",
      "import": "./dist/protocols/anp/index.js",
      "default": "./dist/protocols/anp/index.js"
    },
    "./agents": {
      "types": "./dist/agents/index.d.ts",
      "import": "./dist/agents/index.js",
      "default": "./dist/agents/index.js"
    },
    "./context": {
      "types": "./dist/context/index.d.ts",
      "import": "./dist/context/index.js",
      "default": "./dist/context/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./memory": {
      "types": "./dist/memory/index.d.ts",
      "import": "./dist/memory/index.js",
      "default": "./dist/memory/index.js"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "import": "./dist/tools/index.js",
      "default": "./dist/tools/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js",
      "default": "./dist/utils/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "README_CN.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "tag": "learn"
  },
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test",
    "test:coverage": "bun test --coverage --parallel",
    "build:js": "tsc -p tsconfig.emit.json",
    "build:types": "tsc -p tsconfig.build.json",
    "build": "bun run build:js && bun run build:types",
    "test:node": "node ./tests/node-smoke.mjs && node ./tests/node-todo-devlog-smoke.mjs && node ./tests/security-inspection.mjs",
    "test:package": "node ./tests/package-consumer.mjs",
    "test:integration": "bun run build && node ./tests/real-api-opt-in.mjs",
    "fixture:gate": "bun test tests/learn-fixture-gate.test.ts",
    "release:gate": "bun scripts/release-gate.ts",
    "prepublishOnly": "bun run typecheck && bun run lint && bun run test && bun run build && bun run test:node && bun run test:package"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@qdrant/js-client-rest": "^1.19.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.19.1",
    "eslint": "^9.39.1",
    "neo4j-driver": "^6.2.0",
    "prettier": "^3.9.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  }
}
