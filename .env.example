# Required by HelloAgentsLLM when constructor options are not supplied.
LLM_MODEL_ID=your-model
LLM_API_KEY=replace-with-your-api-key
LLM_BASE_URL=https://your-openai-compatible-endpoint/v1

# Optional LLM settings. LLM_TIMEOUT is expressed in seconds.
LLM_TIMEOUT=60
TEMPERATURE=0.7
MAX_TOKENS=

# Optional framework settings consumed by createConfigFromEnv.
DEBUG=false
LOG_LEVEL=INFO

# Set to 1 only when intentionally running the live-provider integration smoke test.
HELLOAGENTS_INTEGRATION=0
